# GEMINI_API_KEY: Required for Gemini AI API calls (Google AI Studio integrated builder).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional secret for signing session cookies.
SESSION_SECRET=""

# DATABASE_URL: PostgreSQL connection string for permanent persistence on Render/cloud hosts (e.g. Neon, Supabase, Render Postgres).
# Leave empty in local development to use .data/*.json files automatically.
DATABASE_URL=""

# Optional Third-Party OAuth Integrations (Popup OAuth inside the app)
# Callback URLs to register: <APP_URL>/auth/<provider>/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

FIGMA_CLIENT_ID=""
FIGMA_CLIENT_SECRET=""

NETLIFY_CLIENT_ID=""
NETLIFY_CLIENT_SECRET=""
